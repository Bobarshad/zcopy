
config costk 'main'
	option mode 'adaptive'
	option lan_interface 'br-lan'
	option set_name 'costk_bad_clients'
	option destination_mode 'all'
	option accelerate_set_name 'costk_accelerate_dst'
	option never_proxy_set_name 'costk_never_proxy_dst'
	option destination_refresh '300'
	option interval '1'
	option bad_rssi '-72'
	option good_rssi '-65'
	option bad_samples '3'
	option good_samples '10'
	option station_timeout '5'
	option initcwnd_excellent_rssi '-55'
	option initcwnd_good_rssi '-65'
	option initcwnd_fair_rssi '-72'
	option initcwnd_excellent '32'
	option initcwnd_good '20'
	option initcwnd_fair '10'
	option initcwnd_poor '6'
	option initcwnd_down_samples '3'
	option initcwnd_up_samples '10'
	option initcwnd_route_protocol '201'
	option use_splice '1'
	option splice_chunk '65536'
	option relay_batch '200'
	option queue_yield_every '0'
	option relay_stats '0'
	option interfaces 'ath0 ath1'
	option select_middle '1'
	option initcwnd_enabled '1'
	option test_ports '5201 5202 5203'
	option wireless_cca 'westwood'
	option wired_cca 'westwood'

